# Dotfiles environment configuration
# Copy this file to ~/.dotfiles.env and fill in your values
# This file is sourced by shell configs to avoid hardcoding sensitive data

# Git identity
GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="your@email.com"

# SSH hosts (Tailscale or other remote machines)
RPI3_HOST="user@host-or-ip"
RPI5_HOST="user@host-or-ip"
